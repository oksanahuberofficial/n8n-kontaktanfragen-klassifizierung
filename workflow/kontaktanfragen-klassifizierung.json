    {
      "parameters": {
        "jsCode": "const original = $('Eingabe normalisieren').first().json;\nconst raw = $input.first().json.output?.[0]?.content?.[0]?.text\n  ?? $input.first().json.message?.content\n  ?? $input.first().json.content\n  ?? $input.first().json.text\n  ?? '';\n\nlet parsed = null;\ntry {\n  const match = String(raw).match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  parsed = null;\n}\n\nconst gueltigeKategorien = ['Coaching', 'Business & Projekt', 'Recruiter-Anfrage', 'Sonstiges'];\nlet kategorie = parsed?.kategorie;\nlet konfidenz = typeof parsed?.konfidenz === 'number' ? parsed.konfidenz : 0;\nlet begruendung = parsed?.begruendung || 'Keine Begründung von der KI erhalten.';\nlet manuellPruefen = false;\n\nif (!gueltigeKategorien.includes(kategorie)) {\n  kategorie = 'Sonstiges';\n  manuellPruefen = true;\n  begruendung = 'Automatische Zuordnung fehlgeschlagen (ungültige oder fehlende Kategorie) – bitte manuell prüfen. ' + begruendung;\n}\n\nif (konfidenz < 0.55) {\n  manuellPruefen = true;\n}\n\nreturn [{\n  json: {\n    ...original,\n    kategorie,\n    konfidenz,\n    begruendung,\n    manuell_pruefen: manuellPruefen,\n  }\n}];"
      },
